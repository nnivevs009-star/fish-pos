<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Super Admin Dashboard — Fish POS</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #0a1628; color: #e2e8f0;
      font-family: 'Segoe UI', 'Noto Sans Thai', sans-serif;
      min-height: 100vh;
    }
    header {
      background: #0f2044; border-bottom: 1px solid #1e3a5f;
      padding: 0.9rem 1.5rem;
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; flex-wrap: wrap;
    }
    .brand { display: flex; align-items: center; gap: 0.6rem; }
    .brand .fish { font-size: 1.5rem; }
    .brand h1 { font-size: 1.1rem; font-weight: 700; color: #38bdf8; }
    nav a {
      color: #94a3b8; text-decoration: none; font-size: 0.85rem;
      padding: 0.35rem 0.75rem; border-radius: 6px;
      transition: background 0.15s, color 0.15s;
    }
    nav a:hover { background: #1e3a5f; color: #e2e8f0; }
    nav a.active { background: #1e3a5f; color: #38bdf8; }
    .user-chip {
      display: flex; align-items: center; gap: 0.5rem;
    }
    .user-chip .name {
      font-size: 0.82rem; color: #94a3b8; padding: 0.3rem 0.7rem;
      background: #1e3a5f; border-radius: 999px;
    }
    .logout-link {
      font-size: 0.82rem; color: #f87171; text-decoration: none;
      padding: 0.3rem 0.7rem; border: 1px solid rgba(248,113,113,0.3);
      border-radius: 999px; transition: background 0.15s;
    }
    .logout-link:hover { background: rgba(248,113,113,0.1); }
    main { padding: 2rem 1.5rem; max-width: 1100px; margin: 0 auto; }
    h2 { font-size: 1.2rem; font-weight: 700; color: #e2e8f0; margin-bottom: 1.5rem; }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem; margin-bottom: 2rem;
    }
    .stat-card {
      background: #0f2044; border: 1px solid #1e3a5f;
      border-radius: 12px; padding: 1.2rem 1.5rem;
    }
    .stat-card .label { font-size: 0.78rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
    .stat-card .value { font-size: 2rem; font-weight: 700; color: #38bdf8; margin-top: 0.3rem; }
    .stat-card .sub { font-size: 0.78rem; color: #475569; margin-top: 0.2rem; }
    .section-title {
      font-size: 0.9rem; font-weight: 600; color: #94a3b8;
      text-transform: uppercase; letter-spacing: 0.5px;
      margin-bottom: 0.8rem; margin-top: 1.5rem;
    }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    thead tr { border-bottom: 1px solid #1e3a5f; }
    th {
      padding: 0.6rem 0.8rem; text-align: left;
      font-size: 0.75rem; color: #64748b; text-transform: uppercase;
      letter-spacing: 0.5px; font-weight: 600;
    }
    td { padding: 0.7rem 0.8rem; border-bottom: 1px solid rgba(30,58,95,0.5); }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(56,189,248,0.03); }
    .badge {
      display: inline-block; padding: 0.2rem 0.6rem; border-radius: 999px;
      font-size: 0.75rem; font-weight: 600;
    }
    .badge.active { background: rgba(52,211,153,0.15); color: #6ee7b7; border: 1px solid rgba(52,211,153,0.3); }
    .badge.inactive { background: rgba(248,113,113,0.12); color: #fca5a5; border: 1px solid rgba(248,113,113,0.3); }
    .action-link {
      color: #38bdf8; text-decoration: none; font-size: 0.8rem;
      padding: 0.2rem 0.6rem; border: 1px solid rgba(56,189,248,0.3);
      border-radius: 6px; margin-right: 0.3rem; transition: background 0.15s;
    }
    .action-link:hover { background: rgba(56,189,248,0.1); }
    .table-card {
      background: #0f2044; border: 1px solid #1e3a5f;
      border-radius: 12px; overflow: hidden;
    }
  </style>
</head>
<body>
  <header>
    <div class="brand">
      <span class="fish">🐟</span>
      <h1>Fish POS</h1>
    </div>
    <nav>
      <a href="/superadmin/dashboard" class="active">Dashboard</a>
      <a href="/superadmin/branches">สาขา</a>
      <a href="/superadmin/users">ผู้ใช้</a>
    </nav>
    <div class="user-chip">
      <span class="name">&#11088; <%= session.username %></span>
      <a href="/logout" class="logout-link">ออกจากระบบ</a>
    </div>
  </header>

  <main>
    <h2>&#128202; ภาพรวมระบบ</h2>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="label">สาขาทั้งหมด</div>
        <div class="value"><%= total_branches %></div>
        <div class="sub">Active: <%= active_branches %></div>
      </div>
      <div class="stat-card">
        <div class="label">สาขาใช้งาน</div>
        <div class="value"><%= active_branches %></div>
      </div>
      <div class="stat-card">
        <div class="label">ผู้ใช้ทั้งหมด</div>
        <div class="value"><%= total_users %></div>
        <div class="sub">ไม่นับ superadmin</div>
      </div>
    </div>

    <div class="section-title">สถิติแต่ละสาขา</div>
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>ชื่อสาขา</th>
            <th>ที่ตั้ง</th>
            <th>สถานะ</th>
            <th>จำนวนผู้ใช้</th>
            <th>การดำเนินการ</th>
          </tr>
        </thead>
        <tbody>
          <% if (branches_stats.length === 0) { %>
            <tr>
              <td colspan="6" style="text-align:center; color:#475569; padding:2rem;">
                ยังไม่มีสาขา — <a href="/superadmin/branches" style="color:#38bdf8">สร้างสาขาแรก</a>
              </td>
            </tr>
          <% } else { %>
            <% branches_stats.forEach(function(b, i) { %>
              <tr>
                <td style="color:#475569"><%= i+1 %></td>
                <td style="font-weight:600"><%= b.name %></td>
                <td style="color:#94a3b8"><%= b.location || '—' %></td>
                <td>
                  <span class="badge <%= b.status %>">
                    <% if (b.status === 'active') { %>&#10004; Active<% } else { %>&#10007; Inactive<% } %>
                  </span>
                </td>
                <td><%= b.user_count %> คน</td>
                <td>
                  <a href="/superadmin/users" class="action-link">ดูผู้ใช้</a>
                  <a href="/superadmin/branches" class="action-link">จัดการ</a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
