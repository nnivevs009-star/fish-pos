<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>จัดการผู้ใช้ — Fish POS</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #0a1628; color: #e2e8f0;
      font-family: 'Segoe UI', 'Noto Sans Thai', sans-serif;
      min-height: 100vh;
    }
    header {
      background: #0f2044; border-bottom: 1px solid #1e3a5f;
      padding: 0.9rem 1.5rem;
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; flex-wrap: wrap;
    }
    .brand { display: flex; align-items: center; gap: 0.6rem; }
    .brand .fish { font-size: 1.5rem; }
    .brand h1 { font-size: 1.1rem; font-weight: 700; color: #38bdf8; }
    nav a {
      color: #94a3b8; text-decoration: none; font-size: 0.85rem;
      padding: 0.35rem 0.75rem; border-radius: 6px;
    }
    nav a:hover, nav a.active { background: #1e3a5f; color: #38bdf8; }
    .user-chip { display: flex; align-items: center; gap: 0.5rem; }
    .user-chip .name {
      font-size: 0.82rem; color: #94a3b8; padding: 0.3rem 0.7rem;
      background: #1e3a5f; border-radius: 999px;
    }
    .logout-link {
      font-size: 0.82rem; color: #f87171; text-decoration: none;
      padding: 0.3rem 0.7rem; border: 1px solid rgba(248,113,113,0.3);
      border-radius: 999px;
    }
    main { padding: 2rem 1.5rem; max-width: 1200px; margin: 0 auto; }
    h2 { font-size: 1.2rem; font-weight: 700; color: #e2e8f0; margin-bottom: 1.5rem; }
    .msg-banner {
      background: rgba(56,189,248,0.1); border: 1px solid rgba(56,189,248,0.35);
      color: #7dd3fc; border-radius: 8px; padding: 0.75rem 1rem;
      margin-bottom: 1.2rem; font-size: 0.88rem;
    }
    .filter-bar {
      display: flex; gap: 0.75rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap;
    }
    .filter-bar label { font-size: 0.82rem; color: #94a3b8; }
    select {
      background: #0f2044; border: 1px solid #1e3a5f;
      border-radius: 8px; color: #e2e8f0; font-size: 0.85rem;
      padding: 0.4rem 0.8rem; outline: none;
    }
    select:focus { border-color: #38bdf8; }
    .card { background: #0f2044; border: 1px solid #1e3a5f; border-radius: 12px; overflow: hidden; }
    table { width: 100%; border-collapse: collapse; font-size: 0.87rem; }
    th {
      padding: 0.6rem 0.8rem; text-align: left;
      font-size: 0.74rem; color: #64748b; text-transform: uppercase;
      letter-spacing: 0.5px; font-weight: 600; border-bottom: 1px solid #1e3a5f;
    }
    td { padding: 0.7rem 0.8rem; border-bottom: 1px solid rgba(30,58,95,0.5); vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(56,189,248,0.03); }
    .badge {
      display: inline-block; padding: 0.2rem 0.6rem; border-radius: 999px;
      font-size: 0.74rem; font-weight: 600;
    }
    .badge.superadmin { background: rgba(251,191,36,0.2); color: #fde68a; border: 1px solid rgba(251,191,36,0.4); }
    .badge.manager { background: rgba(251,191,36,0.12); color: #fcd34d; border: 1px solid rgba(251,191,36,0.3); }
    .badge.staff { background: rgba(56,189,248,0.12); color: #7dd3fc; border: 1px solid rgba(56,189,248,0.3); }
    .badge.cashier { background: rgba(52,211,153,0.12); color: #6ee7b7; border: 1px solid rgba(52,211,153,0.3); }
    .badge.on { background: rgba(52,211,153,0.15); color: #6ee7b7; border: 1px solid rgba(52,211,153,0.3); }
    .badge.off { background: rgba(248,113,113,0.12); color: #fca5a5; border: 1px solid rgba(248,113,113,0.3); }
    .btn-sm {
      display: inline-block; padding: 0.22rem 0.55rem;
      font-size: 0.77rem; font-weight: 600; border: none;
      border-radius: 6px; cursor: pointer; margin-right: 0.25rem;
    }
    .btn-toggle { background: #1e3a5f; color: #94a3b8; }
    .btn-delete { background: rgba(248,113,113,0.15); color: #fca5a5; border: 1px solid rgba(248,113,113,0.3); }
  </style>
  <script>
    function filterUsers() {
      const val = document.getElementById('branchFilter').value;
      const rows = document.querySelectorAll('tbody tr.user-row');
      rows.forEach(r => {
        if (!val || r.dataset.branch === val) {
          r.style.display = '';
        } else {
          r.style.display = 'none';
        }
      });
    }
  </script>
</head>
<body>
  <header>
    <div class="brand">
      <span class="fish">🐟</span>
      <h1>Fish POS</h1>
    </div>
    <nav>
      <a href="/superadmin/dashboard">Dashboard</a>
      <a href="/superadmin/branches">สาขา</a>
      <a href="/superadmin/users" class="active">ผู้ใช้</a>
    </nav>
    <div class="user-chip">
      <span class="name">&#11088; <%= session.username %></span>
      <a href="/logout" class="logout-link">ออกจากระบบ</a>
    </div>
  </header>

  <main>
    <h2>&#128100; จัดการผู้ใช้ทั้งหมด</h2>

    <% if (message) { %>
      <div class="msg-banner">&#8505; <%= message %></div>
    <% } %>

    <div class="filter-bar">
      <label for="branchFilter">กรองตามสาขา:</label>
      <select id="branchFilter" onchange="filterUsers()">
        <option value="">— ทั้งหมด —</option>
        <% branches.forEach(function(b) { %>
          <option value="<%= b.id %>"><%= b.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="card">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>ชื่อผู้ใช้</th>
            <th>สิทธิ์</th>
            <th>สาขา</th>
            <th>สถานะ</th>
            <th>สร้างเมื่อ</th>
            <th>การดำเนินการ</th>
          </tr>
        </thead>
        <tbody>
          <% if (users.length === 0) { %>
            <tr>
              <td colspan="7" style="text-align:center; color:#475569; padding:2rem;">
                ยังไม่มีผู้ใช้
              </td>
            </tr>
          <% } else { %>
            <% users.forEach(function(u, i) { %>
              <tr class="user-row" data-branch="<%= u.branch_id || '' %>">
                <td style="color:#475569"><%= u.id %></td>
                <td style="font-weight:600"><%= u.username %></td>
                <td><span class="badge <%= u.role %>"><%= u.role %></span></td>
                <td style="color:#94a3b8"><%= u.branch_name || '—' %></td>
                <td>
                  <span class="badge <%= u.is_active ? 'on' : 'off' %>">
                    <%= u.is_active ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td style="color:#64748b; font-size:0.8rem"><%= u.created_at ? u.created_at.slice(0,10) : '—' %></td>
                <td>
                  <% if (u.id !== session.userId) { %>
                    <form method="POST" action="/superadmin/users/<%= u.id %>/toggle" style="display:inline">
                      <button type="submit" class="btn-sm btn-toggle">
                        <%= u.is_active ? 'ปิด' : 'เปิด' %>
                      </button>
                    </form>
                    <form method="POST" action="/superadmin/users/<%= u.id %>/delete" style="display:inline"
                      onsubmit="return confirm('ลบผู้ใช้ <%= u.username %>?')">
                      <button type="submit" class="btn-sm btn-delete">ลบ</button>
                    </form>
                  <% } else { %>
                    <span style="font-size:0.78rem; color:#475569">(คุณ)</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <div style="margin-top:1.2rem; text-align:right;">
      <a href="/superadmin/branches" style="color:#38bdf8; font-size:0.85rem; text-decoration:none;">
        &#8594; สร้างรหัสเชิญที่หน้าสาขา
      </a>
    </div>
  </main>
</body>
</html>
